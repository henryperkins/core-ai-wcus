{
	"name": "core-ai-map",
	"version": "3.2.3",
	"description": "An interactive Living Block Map of the building blocks connecting WordPress and AI.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"files": [
		"assets",
		"build",
		"core-ai-map.php",
		"README.md",
		"readme.txt"
	],
	"scripts": {
		"build": "wp-scripts build --experimental-modules --webpack-copy-php --blocks-manifest",
		"build:playground": "node scripts/build-cloudflare-playground.mjs",
		"create:playground-source-fixture": "node tests/playground/create-static-source-fixture.mjs",
		"format": "wp-scripts format",
		"generate:qr": "node scripts/generate-qr.mjs",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --experimental-modules --webpack-copy-php --blocks-manifest",
		"test:playground": "node --test tests/playground/artifact-verification.test.mjs tests/playground/blueprint.test.mjs tests/playground/cloudflare-build.test.mjs tests/playground/plugin-release-identity.test.mjs",
		"test:unit": "wp-scripts test-unit-js",
		"verify:playground-artifact": "node scripts/verify-playground-artifact.mjs"
	},
	"dependencies": {
		"@wordpress/block-editor": "16.1.0",
		"@wordpress/blocks": "15.25.0",
		"@wordpress/components": "38.0.0",
		"@wordpress/i18n": "6.25.0",
		"@wordpress/interactivity": "6.52.0"
	},
	"devDependencies": {
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@wordpress/scripts": "34.0.0",
		"adm-zip": "0.5.18",
		"qrcode": "1.5.4"
	}
}
